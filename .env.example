# Firebase (already set)
VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# Google Gemini AI — free key at https://aistudio.google.com/app/apikey
VITE_GEMINI_API_KEY=AIza...

# Mailer backend on Render (sends FROM your Gmail — see setup guide)
VITE_MAILER_URL=https://your-app-name.onrender.com
VITE_MAILER_SECRET=teachdesk123

# Optional: your UPI ID shown on billing emails
VITE_UPI_ID=yourname@upi
